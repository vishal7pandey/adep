# ADEP environment variables
# Copy this file to .env and fill in your values.

# Model provider [ADE-41]: "auto" uses OpenAI when OPENAI_API_KEY is set, otherwise Azure.
# Set ADE_LLM_PROVIDER=openai or azure to force one.
ADE_LLM_PROVIDER=auto

# OpenAI (direct API), used by both the old and the new engine
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-5.4

# Azure OpenAI — alternative provider (GPT-5.4) [AKM]
AZURE_API_KEY=your-azure-api-key-here
AZURE_CHAT_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
AZURE_CHAT_DEPLOYMENT=gpt-5.4

# Provider selection [§9]
ADE_OCR_PROVIDER=paddle
ADE_VLM_PROVIDER=azure

# Validation thresholds [§4.1]
ADE_DEFAULT_CONFIDENCE_THRESHOLD=0.8

# Give-up caps [§2.6]
ADE_MAX_CYCLES_PER_FIELD=5
ADE_MAX_CYCLES_PER_DOCUMENT=30

# Trace compaction [§12.3]
ADE_TRACE_WINDOW_SIZE=10

# Context compaction [§12.4]
ADE_COMPACTION_ENABLED=true
ADE_COMPACTION_THRESHOLD=15

# Logging [LS]
ADE_LOG_LEVEL=INFO

# Token pricing per 1K tokens (USD) [BLK-050]
ADE_LLM_PRICING_INPUT_PER_1K=0.005
ADE_LLM_PRICING_OUTPUT_PER_1K=0.015
ADE_VLM_PRICING_INPUT_PER_1K=0.01
ADE_VLM_PRICING_OUTPUT_PER_1K=0.03

# Budget limits [BLK-051]
ADE_BUDGET_PER_RUN_TOKENS=100000
ADE_BUDGET_PER_RUN_COST_USD=1.0
ADE_BUDGET_PER_DEFINITION_DAILY_TOKENS=1000000
ADE_BUDGET_PER_DEFINITION_DAILY_COST_USD=10.0
ADE_BUDGET_GLOBAL_DAILY_TOKENS=10000000
ADE_BUDGET_GLOBAL_DAILY_COST_USD=100.0
ADE_BUDGET_WARNING_THRESHOLD=0.8

# Authentication [BLK-122, BLK-153]
# Set to false ONLY for local development. A startup warning is logged when disabled.
# Production deployments MUST keep this set to true.
ADE_AUTH_ENABLED=true
